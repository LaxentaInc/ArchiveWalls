{
  "manifest_version": 3,
  "name": "Archive Walls",
  "version": "0.1.0",
  "description": "Live wallpaper new tab, visual bookmark hub, and ColorWall desktop web clipper",
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "contextMenus",
    "downloads",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_title": "Archive Walls"
  }
}
